# HTTPS is automatic: Caddy requests a certificate for this name once DNS points here.
client.keyset.in {
	encode zstd gzip
	# Uploads are capped at 10 MB by the app; leave room for the form around them.
	request_body {
		max_size 12MB
	}
	reverse_proxy app:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
}
