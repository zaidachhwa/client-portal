# Copy to .env.production on the server and fill in. Never commit the real file (.env* is git-ignored).
APP_URL=https://client.keyset.in

# MongoDB Atlas connection string (Atlas clusters are replica sets, so transactions work).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/client-portal?retryWrites=true&w=majority

# Uploads: Cloudinary (recommended). Without it files are stored in the server's "uploads" volume.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Email via Resend. MAIL_FROM must be on a domain you've verified in Resend (e.g. keyset.in).
RESEND_API_KEY=re_...
MAIL_FROM=Keyset Client Portal <portal@keyset.in>
