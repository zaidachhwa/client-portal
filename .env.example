# Local development. Copy to .env.local and fill in; .env.local is git-ignored.
# For production see .env.production.example.

# Local MongoDB from docker-compose.yml (a single-node replica set, so transactions work).
MONGODB_URI=mongodb://127.0.0.1:27037/client-portal?directConnection=true

# Absolute links in emails.
APP_URL=http://localhost:3000

# Optional: uploads go to Cloudinary when set, otherwise to ./storage.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Optional: email via Resend; without it emails are printed to the server log.
# MAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=re_...
MAIL_FROM=Client Portal <portal@your-domain.com>
